# Gemini API 키 — 서버 라우트에서만 쓴다. NEXT_PUBLIC_ 접두사에 절대 넣지 마라.
GEMINI_API_KEY=AIza...

# 선택: 모델 폴백 체인 전체의 시간 예산(ms). 기본 15000.
# Vercel 함수 타임아웃보다 넉넉히 짧게 잡아야 502 대신 사람이 읽을 수 있는 에러가 나간다.
AI_DEADLINE_MS=15000

# 선택: Vercel KV 캐시 (KV 스토어를 붙이면 자동으로 주입된다).
# 없으면 람다 인스턴스 메모리 캐시로 폴백한다.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 선택: 외부 시세 API 없이 UI만 돌려볼 때 (합성 데이터, 실제 시세 아님)
# DATA_PROVIDER=fixture

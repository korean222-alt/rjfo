# Gemini API 키 — 서버 라우트에서만 쓴다. NEXT_PUBLIC_ 접두사에 절대 넣지 마라.
GEMINI_API_KEY=AIza...

# 선택: 모델 폴백 체인 전체의 시간 예산(ms). 기본 15000.
# Vercel 함수 타임아웃보다 넉넉히 짧게 잡아야 502 대신 사람이 읽을 수 있는 에러가 나간다.
AI_DEADLINE_MS=15000

# 선택: Vercel KV(Upstash Redis) 캐시. 스토어를 프로젝트에 연결하면 자동으로 주입된다.
# 비워 두면 람다 인스턴스 메모리 캐시로 폴백한다 — 동작은 하지만 인스턴스마다 따로라
# 외부 시세 API를 그만큼 더 자주 부르게 된다(= 429 확률 상승). 붙이는 걸 권장.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 시세 API 키 (강력 권장) — twelvedata.com 무료 가입으로 즉시 발급, 하루 800회.
# Yahoo/Stooq 같은 무료·비공식 소스는 Vercel 같은 데이터센터 IP를 통째로 막는다.
# 그래서 배포 환경에서는 이 키가 있어야 안정적으로 동작한다.
# 키가 있으면 이 소스를 1순위로 쓰고, 실패하면 Yahoo → Stooq 순으로 폴백한다.
TWELVE_DATA_API_KEY=

# 선택: 시세 소스 강제. 기본은 (키 있으면 twelvedata →) yahoo → stooq 폴백 체인.
#   twelvedata | yahoo | stooq | fixture
# DATA_PROVIDER=stooq

# 선택: Yahoo 재시도 전체의 시간 예산(ms). 기본 6000.
# DATA_DEADLINE_MS=6000


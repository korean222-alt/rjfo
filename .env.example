# Claude API key — server-side only. NEVER prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Vercel KV cache (set automatically when you attach a KV store on Vercel).
# Without these the app falls back to an in-memory cache (per-lambda, still works).
KV_REST_API_URL=
KV_REST_API_TOKEN=

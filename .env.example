# Gemini API 키 — 서버 라우트에서만 쓴다. NEXT_PUBLIC_ 접두사에 절대 넣지 마라.
GEMINI_API_KEY=AIza...

# 선택: 모델 폴백 체인 전체의 시간 예산(ms). 기본 15000.
# Vercel 함수 타임아웃보다 넉넉히 짧게 잡아야 502 대신 사람이 읽을 수 있는 에러가 나간다.
AI_DEADLINE_MS=15000

# 선택: Vercel KV(Upstash Redis) 캐시. 스토어를 프로젝트에 연결하면 자동으로 주입된다.
# 비워 두면 람다 인스턴스 메모리 캐시로 폴백한다 — 동작은 하지만 인스턴스마다 따로라
# 외부 시세 API를 그만큼 더 자주 부르게 된다(= 429 확률 상승). 붙이는 걸 권장.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 시세 API 키 (강력 권장) — twelvedata.com 무료 가입으로 즉시 발급, 하루 800회.
# Yahoo/Stooq 같은 무료·비공식 소스는 Vercel 같은 데이터센터 IP를 통째로 막는다.
# 그래서 배포 환경에서는 이 키가 있어야 안정적으로 동작한다.
# 키가 있으면 이 소스를 1순위로 쓰고, 실패하면 Yahoo → Stooq 순으로 폴백한다.
TWELVE_DATA_API_KEY=

# 선택: 시세 소스 강제. 기본은 (키 있으면 twelvedata →) yahoo → stooq 폴백 체인.
#   twelvedata | yahoo | stooq | fixture
# DATA_PROVIDER=stooq

# 선택: Yahoo 재시도 전체의 시간 예산(ms). 기본 6000.
# DATA_DEADLINE_MS=6000


# ── 텔레그램 알림 (선택) ───────────────────────────────────────────────
# 등록한 종목에 신호가 뜬 날, 미국장 마감 뒤에 텔레그램으로 알려준다.
# 셋 다 있어야 동작한다: 봇 토큰 + 채팅 id + KV(알림 목록 저장소).

# 1) 텔레그램에서 @BotFather 에게 /newbot → 받은 토큰
TELEGRAM_BOT_TOKEN=

# 2) 그 봇에게 아무 메시지나 한 번 보낸 뒤 /api/alerts/chat-id 를 열면 나온다.
TELEGRAM_CHAT_ID=

# 3) 알림 목록은 위의 KV_REST_API_URL / KV_REST_API_TOKEN 에 저장된다.
#    (시세 캐시와 같은 스토어를 쓴다. 따로 만들 필요 없다.)

# 크론은 두 개다:
#   /api/alerts/check        22:00 UTC — 사람이 고른 조건 알림
#   /api/alerts/grade/check  22:30 UTC — A등급(여섯 관문 통과) 신호 알림

# 선택: Vercel Cron 보호. 값을 넣어 두면 /api/alerts/check 는 Vercel Cron이
# 붙여 주는 Authorization 헤더가 있을 때만 응답한다. 넣는 걸 권장.
CRON_SECRET=

# 선택: api.telegram.org 가 막힌 망에서 프록시를 끼울 때만. 기본값 그대로 두면 된다.
# TELEGRAM_API_BASE=https://api.telegram.org
